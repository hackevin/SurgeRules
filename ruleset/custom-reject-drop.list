# ============================================================
# 名称: custom-reject-drop
# 类型: REJECT-DROP
# 说明: 日志、遥测、监控及推送长连接（避免客户端反复重连超时）
# 适用: Surge / Shadowrocket
# ============================================================

# ===== 字节系：日志 / 监控 =====
DOMAIN-REGEX,^ads.*-normal-.*\.amemv\.com$
DOMAIN-REGEX,^ads.*-normal-.*\.zijieapi\.com$
DOMAIN-REGEX,^ads.*-normal-.*\.fqnovel\.com$
DOMAIN-REGEX,^log.*-misc-.*\.amemv\.com$
DOMAIN-REGEX,^log.*-misc-.*\.zijieapi\.com$
DOMAIN-REGEX,^log.*-misc-.*\.fqnovel\.com$
DOMAIN-REGEX,^mon.*-misc-.*\.amemv\.com$
DOMAIN-REGEX,^mon.*-misc-.*\.zijieapi\.com$
DOMAIN-REGEX,^mon.*-misc-.*\.fqnovel\.com$
DOMAIN-REGEX,^rtlog.*-.*\.zijieapi\.com$
DOMAIN-REGEX,^rtlog.*-.*\.amemv\.com$
DOMAIN-REGEX,^.*-applog-.*\.zijieapi\.com$
DOMAIN-REGEX,^.*-applog-.*\.amemv\.com$
DOMAIN-REGEX,^.*-applog-.*\.fqnovel\.com$
DOMAIN-REGEX,^abtest.*-misc-.*\.zijieapi\.com$
DOMAIN-REGEX,^abtest.*-misc-.*\.amemv\.com$
DOMAIN-REGEX,^abtest.*-misc-.*\.fqnovel\.com$
DOMAIN-REGEX,^mssdk.*-normal-.*\.zijieapi\.com$
DOMAIN-REGEX,^polaris.*-normal-.*\.zijieapi\.com$
DOMAIN-REGEX,^saveu.*-normal-.*\.zijieapi\.com$
DOMAIN-REGEX,^tnc.*-.*\.zijieapi\.com$
DOMAIN-REGEX,^tnc.*-.*\.bytedance\.com$
DOMAIN-REGEX,^.*-analytics\.bytescm\.com$
DOMAIN-SUFFIX,ctobsnssdk.com
DOMAIN,logbk.amemv.com
DOMAIN,timon.zijieapi.com
DOMAIN,vcs.zijieapi.com
DOMAIN,feedback-c.zijieapi.com
DOMAIN,live-player-log-service.bytedance.com
DOMAIN,dm.bytedance.com
DOMAIN,dm.toutiao.com
DOMAIN,dm-hl.toutiao.com
DOMAIN,monsetting.toutiao.com
DOMAIN,abtest-ch.snssdk.com
DOMAIN,mssdk.volces.com
DOMAIN-REGEX,^mcs.*\.zijieapi\.com$
DOMAIN-REGEX,^crash.*\.zijieapi\.com$
DOMAIN-REGEX,^slardar.*\.zijieapi\.com$
DOMAIN-REGEX,^apm.*\.volces\.com$

# ===== 通用日志 / 监控前缀 =====
DOMAIN-REGEX,^applog\..+$
DOMAIN-REGEX,^analytics\..+$
DOMAIN-REGEX,^logs?\..+$
DOMAIN-REGEX,^mon\..+$
DOMAIN-REGEX,^rtlog.*\..+$
DOMAIN-REGEX,^telemetry\..+$
DOMAIN-REGEX,^.+\.telemetry\..+$

# ===== 小红书 =====
DOMAIN-REGEX,^apm-.*\.xiaohongshu\.com$
DOMAIN,t2.xiaohongshu.com
DOMAIN,lng.xiaohongshu.com
DOMAIN,spider-tracker.xiaohongshu.com
DOMAIN,crash.xiaohongshu.com

# ===== 微软遥测 =====
DOMAIN-SUFFIX,events.data.microsoft.com
DOMAIN-REGEX,^vortex.*\.data\.microsoft\.com$
DOMAIN-SUFFIX,pipe.aria.microsoft.com
DOMAIN-SUFFIX,applicationinsights.microsoft.com
DOMAIN,watson.microsoft.com
DOMAIN,in.appcenter.ms

