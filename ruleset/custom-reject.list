# ============================================================
# 名称: custom-reject
# 类型: REJECT
# 说明: 广告联盟、广告平台、海外归因/分析 SDK、厂商广告域名
# 适用: Surge / Shadowrocket
# ============================================================

# ################ 一、通用规则（正则 / 关键字）################
# ===== 通用通配正则（替代 DOMAIN-WILDCARD）=====
DOMAIN-REGEX,^ads\..+$
DOMAIN-REGEX,^adservice\..+$
DOMAIN-REGEX,^beacon\..+$
DOMAIN-REGEX,^.+\.beacon\..+$
DOMAIN-REGEX,^beacon-.*$

# ===== 通用前缀通配正则（httpdns / 配置下发）=====
DOMAIN-REGEX,^amdc\..+$
DOMAIN-REGEX,^cfgc\..+$
DOMAIN-REGEX,^h-adashx\.ut\..+$

