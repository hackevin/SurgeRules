#!name=Spotify 去广告
#!desc=去除播放广告及界面广告。登录后再启用，重启 App 等待生效，音质无法设为超高
#!author=app2smile / ddgksf2013 (Surge 适配)
#!version=1.2.0
#!category=去广告

[Rule]
# 广告追踪域名
DOMAIN,adeventtracker.spotify.com,REJECT
DOMAIN,ads-fa.spotify.com,REJECT
DOMAIN,audio2.spotify.com,REJECT
# Mac 桌面版广告接口（直接 REJECT，无需脚本）
URL-REGEX,^https://spclient\.wg\.spotify\.com/ad-logic/,REJECT
URL-REGEX,^https://spclient\.wg\.spotify\.com/ads/,REJECT
URL-REGEX,^https://spclient\.wg\.spotify\.com/sponsoredplaylist/,REJECT
URL-REGEX,^https://.*-spclient\.spotify\.com/storage-resolve/.*product=0,REJECT

[Script]
# 播放队列去广告（iOS / Mac 通用）
Spotify-AdSkip = type=http-response,pattern=^https://spclient\.wg\.spotify\.com/melody/v1/playback_context,requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/hackevin/SurgeRules/refs/heads/Surge/js/spotify_adskip.js
Spotify-Gabo = type=http-response,pattern=^https://spclient\.wg\.spotify\.com/gabo-receiver-service/,requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/hackevin/SurgeRules/refs/heads/Surge/js/spotify_adskip.js
# 歌手/专辑列表：伪装 iPad 平台以正常展示
Spotify-Json = type=http-request,pattern=^https://(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)/(artistview/v1/artist|album-entity-view/v2/album)/,requires-body=false,script-path=https://raw.githubusercontent.com/hackevin/SurgeRules/refs/heads/Surge/js/spotify_json.js

# ---- Premium 解锁（注意：启用后可能导致账号被踢出登录）----
# Spotify-Header = type=http-request,pattern=^https://(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)/user-customization-service/v1/customize$,requires-body=false,script-path=https://raw.githubusercontent.com/app2smile/rules/master/js/spotify-qx-header.js
# Spotify-Proto = type=http-response,pattern=^https://(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)/(bootstrap/v1/bootstrap|user-customization-service/v1/customize)$,requires-body=true,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/hackevin/SurgeRules/refs/heads/Surge/js/spotify-proto.js

[MITM]
hostname = %APPEND% spclient.wg.spotify.com,*-spclient.spotify.com
