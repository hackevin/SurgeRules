#!name=多邻国解锁去广告
#!desc=解锁Duolingo无限体力去广告
#!author=Claude
#!version=2026.3.31
#!category=去广告

[Rule]
# 广告域名用 Rule，不需要 MITM，性能好
DOMAIN-SUFFIX,appsflyer.com,REJECT-DROP
DOMAIN-SUFFIX,adjust.com,REJECT-DROP
DOMAIN-SUFFIX,adjust.io,REJECT-DROP
DOMAIN-SUFFIX,mopub.com,REJECT-DROP
DOMAIN-SUFFIX,amplitude.com,REJECT-DROP
DOMAIN-SUFFIX,braze.com,REJECT-DROP
DOMAIN-SUFFIX,googlesyndication.com,REJECT-DROP
DOMAIN-SUFFIX,doubleclick.net,REJECT-DROP
DOMAIN-SUFFIX,googleadservices.com,REJECT-DROP
DOMAIN-SUFFIX,adcolony.com,REJECT-DROP
DOMAIN-SUFFIX,unity3d.com,REJECT-DROP
DOMAIN-SUFFIX,vungle.com,REJECT-DROP
DOMAIN-SUFFIX,applovin.com,REJECT-DROP
DOMAIN-SUFFIX,ironsource.com,REJECT-DROP
DOMAIN-SUFFIX,chartboost.com,REJECT-DROP
DOMAIN-SUFFIX,xtremepush.com,REJECT-DROP
URL-REGEX,^https?://ios-api-2\.duolingo\.cn/\d{4}-\d{2}-\d{2}/plus-promotions/,REJECT-DROP
URL-REGEX,^https?://ios-api-2\.duolingo\.cn/\d{4}-\d{2}-\d{2}/users/\d+/ads/,REJECT-DROP

[Script]
多邻国解锁 = type=http-response,pattern=^https?://ios-api-2\.duolingo\.cn/\d{4}-\d{2}-\d{2}/users/\d+[^/]*$,requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/hackevin/SurgeRules/refs/heads/Surge/js/duolingo_adskipvip.js
多邻国去广告 = type=http-request,pattern=^https?://ios-api-2\.duolingo\.cn/\d{4}-\d{2}-\d{2}/users/\d+/ads/,requires-body=false,script-path=https://raw.githubusercontent.com/hackevin/SurgeRules/refs/heads/Surge/js/duolingo_adskipvip.js

[URL Rewrite]
^https?://ios-api-2\.duolingo\.cn/\d{4}-\d{2}-\d{2}/plus-promotions/.* - reject
# 广告配置接口
^https?://ios-api-2\.duolingo\.cn/\d{4}-\d{2}-\d{2}/users/\d+/ads/.* - reject

[MITM]
hostname = %APPEND% ios-api-2.duolingo.cn
