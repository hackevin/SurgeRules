#!name=Quora 去广告
#!desc=屏蔽 Quora 广告追踪域名、拦截广告 API，过滤信息流广告条目
#!author=hackevin
#!version=1.0.0
#!category=去广告

[Rule]
# 广告追踪域名
DOMAIN,ads.quora.com,REJECT-DROP
DOMAIN,pixel.quora.com,REJECT-DROP
DOMAIN,qsf.quora.com,REJECT-DROP
DOMAIN-SUFFIX,quora-ads.com,REJECT-DROP

# 广告及追踪 API 接口
URL-REGEX,^https?://www\.quora\.com/ads,REJECT-DROP
URL-REGEX,^https?://www\.quora\.com/api/ads/,REJECT-DROP
URL-REGEX,^https?://www\.quora\.com/analytics/,REJECT-DROP
URL-REGEX,^https?://www\.quora\.com/qevents/,REJECT-DROP
URL-REGEX,^https?://www\.quora\.com/events/,REJECT-DROP

[Script]
# 过滤信息流中的广告条目
Quora-Ads = type=http-response,pattern=^https?://www\.quora\.com/api/mobile/v\d+/(feed|home|search|answer),requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/hackevin/SurgeRules/refs/heads/Surge/js/quora_adskip.js

[MITM]
hostname = %APPEND% www.quora.com
