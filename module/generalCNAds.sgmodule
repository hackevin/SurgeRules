#!name=国内App去广告增强
#!desc=通用广告SDK拦截 + B站/京东/美团/移动开屏去广告
#!author=claude
#!version=2.0.0
#!category=去广告

[Rule]

# === 通用广告追踪 SDK ===
DOMAIN-SUFFIX,adjust.com,REJECT-DROP
DOMAIN-SUFFIX,appsflyer.com,REJECT-DROP
DOMAIN-SUFFIX,branch.io,REJECT-DROP

# === 腾讯广告 ===
DOMAIN-SUFFIX,gdt.qq.com,REJECT-DROP
DOMAIN-SUFFIX,adsmind.gdtimg.com,REJECT-DROP

# === 阿里广告 ===
DOMAIN-SUFFIX,alimama.com,REJECT-DROP
DOMAIN-SUFFIX,mmstat.com,REJECT-DROP

# === 京东广告 ===
DOMAIN,jdad.jd.com,REJECT-DROP

# === 字节广告 ===
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT-DROP
DOMAIN-SUFFIX,byteoversea.com,REJECT-DROP

# === 百度广告 ===
DOMAIN,mobads.baidu.com,REJECT-DROP
DOMAIN,hm.baidu.com,REJECT-DROP

# === 美团广告（仅广告子域，不拦截主域）===
DOMAIN,ad.meituan.com,REJECT-DROP
DOMAIN,adfront.meituan.com,REJECT-DROP
DOMAIN,ad.dianping.com,REJECT-DROP

# === 网易广告 ===
DOMAIN,adgeo.163.com,REJECT-DROP

# === 小米追踪 ===
DOMAIN,tracking.miui.com,REJECT-DROP

# === 谷歌广告（国内 app 内嵌）===
DOMAIN-SUFFIX,doubleclick.net,REJECT-DROP
DOMAIN-SUFFIX,googlesyndication.com,REJECT-DROP

# === 移动广告域名 ===
DOMAIN,ad.10086.cn,REJECT-DROP

[Map Local]
# === 京东开屏广告 ===
^https?://api\.m\.jd\.com/client\.action\?functionId=startUp data="https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/refs/heads/master/blank/blank_dict.json"

# === 美团开屏广告 ===
^https?://wmapi\.meituan\.com/api/v\d+/loadInfo data="https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/refs/heads/master/blank/blank_dict.json"

# === 大众点评开屏广告 ===
^https?://mapi\.dianping\.com/.*splash data="https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/refs/heads/master/blank/blank_dict.json"

[MITM]
hostname = %APPEND% app.bilibili.com,api.bilibili.com,api.m.jd.com,wmapi.meituan.com,mapi.dianping.com
