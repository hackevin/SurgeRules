#!name=车来了净化 (Surge版)
#!desc=去除车来了小程序/APP广告、底栏、信息流、隐私追踪。由 ddgksf2013 原规则适配 Surge。
#!author=ddgksf2013 & Claude
#!version=1.0.5
#!update-url=https://raw.githubusercontent.com/hackevin/SurgeRules/refs/heads/Surge/sgmodule/chelaileads.sgmodule
#!homepage=https://github.com/ddgksf2013/Rewrite
#!category=去广告

[Rule]
# > 第三方广告追踪域名
DOMAIN,adx.sogaha.cn,REJECT-DROP
DOMAIN,ctrace.sogaha.cn,REJECT-DROP
DOMAIN,xigua.sogaha.cn,REJECT-DROP
DOMAIN,logs.chelaile.net.cn,REJECT-DROP

# > 广告/信息流接口
URL-REGEX,^https?://[^/]*\.chelaile\.net\.cn/(api/)?adpub,REJECT-DROP
URL-REGEX,^https?://[^/]*\.chelaile\.net\.cn/goocity/flowPos/listByPos,REJECT-DROP
URL-REGEX,^https?://web\.chelaile\.net\.cn/api/operative_position/infoflow,REJECT-DROP
URL-REGEX,^https?://cdn\.web\.chelaile\.net\.cn/info-flow/index\.html,REJECT-DROP
URL-REGEX,^https?://atrace\.chelaile\.net\.cn/(wx_preloadAd|adAnalysis),REJECT-DROP

# > IP 直连广告接口
URL-REGEX,^https?://124\.70\.194\.16/(ip|adpub|goocity/flowPos/listByPos),REJECT-DROP

[Script]
# > 去除底栏（requires-body=true 必须开启）
车来了去底栏 = type=http-response, pattern=^https?://[^/]*\.chelaile\.net\.cn/goocity/city!, requires-body=true, script-path=https://raw.githubusercontent.com/hackevin/SurgeRules/refs/heads/Surge/js/chelaile_adskip.js, timeout=10, script-update-interval=86400

[MITM]
hostname = %APPEND% *.chelaile.net.cn, 124.70.194.16
