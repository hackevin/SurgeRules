#!name=中国移动去广告进阶版
#!desc=精细化过滤开屏、弹窗及首页牛皮癣广告，优化加载速度
#!category=去广告

[Rule]
# 核心广告域名拦截
DOMAIN,ad.10086.cn,REJECT-DROP
DOMAIN,adcdn.10086.cn,REJECT-DROP
DOMAIN,msg.10086.cn,REJECT-DROP
DOMAIN,promotion.10086.cn,REJECT-DROP
DOMAIN,amdc.m.taobao.com,REJECT-DROP

# SDK 拦截 - 防止摇一摇跳转（穿山甲广告域名）
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT-DROP
DOMAIN-SUFFIX,pglstatp-toutiao.co,REJECT-DROP

URL-REGEX,^https?://client.app.coc.10086.cn/biz-orange/DN/init/startInit,REJECT-DROP

[URL Rewrite]
# 开屏广告初始化接口
^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/init\/startInit url reject-200
^https?+:\/\/clientaccess\.10086\.cn\/biz-orange\/DN\/init\/startInit url reject-200

# 广告列表接口
^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/explorePage\/getAdverList url reject

# 悬浮窗（多个）
^https?:\/\/(client\.app\.coc|h\.app\.coc|app)\.10086\.cn\/biz-orange\/DN\/emotionMarket url reject

# 促销广告图
^https?:\/\/gd\.10086\.cn\/gmccfile\/file\/image\/preloading703\/.*.jpg url reject-img

# 首页销售广告
^https?:\/\/app\.10086\.cn\/biz-orange\/DN\/(findSale|homeSale)\/getsaleAdver url reject

# 广告图片资源
^https?:\/\/res\.app\.coc\.10086\.cn\/group\d\/M00\/[0-9]{2}\/[A-Z0-9]{2}\/.+\.jpg url reject-200

# 营销内容 feed
^https?+:\/\/wap\.js\.10086\.cn\/jsmccClient\/cd\/market_content\/api\/v\d\/market_content\.page\.query url reject-200

# 屏蔽咪咕视频预加载广告
^https?://ad\.cmvideo\.cn/.* - reject

[MITM]
hostname = %APPEND% client.app.coc.10086.cn, h.client.app.coc.10086.cn, app.10086.cn, gd.10086.cn, res.app.coc.10086.cn, clientaccess.10086.cn

